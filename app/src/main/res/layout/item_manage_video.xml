<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 封面区域 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:scaleType="centerCrop"
                android:background="@drawable/ic_video_placeholder"
                android:contentDescription="@string/app_name" />

            <!-- 文件失效蒙层 -->
            <View
                android:id="@+id/viewInvalidOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#BB000000"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvInvalidBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="#CC000000"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/manage_invalid_label"
                android:textColor="#FFCCCC"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!--
                左下角徽标行：点赞数 +「未看过」标记（后者紧贴前者右侧）。
                两个徽标各自独立控制显隐，点赞数为 0 时「未看过」自然顶到最左。
            -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 点赞数徽标：心形图标 + 数字；心形白色，我点赞过（userRelation 含 like）的着抖音红；diggCount<=0 时 GONE -->
                <TextView
                    android:id="@+id/tvDiggCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#99000000"
                    android:drawableStart="@drawable/ic_heart_solid"
                    android:drawablePadding="3dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:ignore="SmallSp" />

                <!-- 「未看过」标记：watched == false 且当前 Tab 支持时显示（图片 Tab 不显示） -->
                <TextView
                    android:id="@+id/tvUnwatchedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="#CCE64A19"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="@string/manage_unwatched_label"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:ignore="SmallSp" />
            </LinearLayout>

            <!--
                「已导出」标记（左上角）：exportCount > 0 且处于多选态时显示。
                只在多选态出现，因为它服务于"这批要不要再导一次"的判断。
            -->
            <TextView
                android:id="@+id/tvExportedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:background="#CC00875A"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/manage_exported_label"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:ignore="SmallSp" />

            <!-- 多选时的选中蒙层 -->
            <View
                android:id="@+id/viewSelectedOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#552196F3"
                android:visibility="gone" />

            <!-- 多选时的复选框（右上角） -->
            <CheckBox
                android:id="@+id/cbManageSelect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:buttonTint="#2196F3"
                android:clickable="false"
                android:focusable="false"
                android:visibility="gone" />

        </FrameLayout>

        <!-- 信息区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="7dp"
            android:paddingTop="6dp"
            android:paddingBottom="7dp">

            <!--
                作者行：点击加载 TA 的发布作品。
                wrap_content 而不是 match_parent —— 热区只包住图标+文字，右侧空白不可点，避免误触。
                父容器是 match_parent 的纵向 LinearLayout，会把本行夹在卡片宽度内，
                所以长昵称的 ellipsize 照常生效。
                background 常驻这里、不在代码里切：没有 sec_user_id 的旧记录只把 isClickable
                置 false（不可点的 View 不会起水波），Adapter 里就不用解析主题属性。
            -->
            <LinearLayout
                android:id="@+id/authorRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="?attr/selectableItemBackground">

                <!-- 与列表下载页「查看TA的Post」按钮共用同一个图标，语义可迁移 -->
                <ImageView
                    android:id="@+id/ivAuthorIcon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_author_posts"
                    app:tint="?android:attr/textColorSecondary"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>

            <!-- 描述文案（空时隐藏） -->
            <TextView
                android:id="@+id/tvDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="10sp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone" />

            <!-- 标签行：downloadType chip + userRelation chips -->
            <LinearLayout
                android:id="@+id/tagContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal" />

            <!--
                用户自定义标签行（无标签时隐藏）。
                vertical 容器：由 ManageGridAdapter 在运行时把 chip 分到最多两行；
                第二行放不下时尾部用「+N」概要 chip。
            -->
            <LinearLayout
                android:id="@+id/userTagContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
