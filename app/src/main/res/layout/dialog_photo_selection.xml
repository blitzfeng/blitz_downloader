<?xml version="1.0" encoding="utf-8"?>
<!--
    图集选图底部弹窗（PhotoSelectionBottomSheet）。

    横向 ViewPager2 逐张预览，勾选框在每一页的图片下方（item_photo_selection_page.xml），
    因此这里只放标题 / 页码 / 全选 / 完成这些跨页控件。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/tvPhotoSheetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/photo_pick_title" />

        <TextView
            android:id="@+id/tvPhotoSheetCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/photoPager"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/tvPhotoPageIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPhotoToggleAll"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/photo_pick_deselect_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPhotoDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/photo_pick_done" />

    </LinearLayout>

</LinearLayout>
