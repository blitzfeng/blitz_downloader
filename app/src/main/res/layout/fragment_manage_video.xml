<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 标签过滤栏（水平横向 RecyclerView） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTagFilter"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="?android:attr/colorBackground"
        android:clipToPadding="false"
        android:paddingHorizontal="4dp" />

    <!--
        作者筛选后的「高频标签」快捷筛选块，默认隐藏；只在有作者筛选且该作者有高频标签时显示
        （见 ManageVideoFragment.renderAuthorHighFreqTagBar）。
    -->
    <LinearLayout
        android:id="@+id/authorHighFreqTagBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/tvAuthorHighFreqTagsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manage_author_high_freq_tags_label"
            android:textSize="12sp"
            android:textColor="@color/text_color_secondary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAuthorHighFreqTags"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- 视频网格列表区域 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshManageVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvManageVideos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="4dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/progressManageVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEmptyManageVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/manage_empty_videos"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
