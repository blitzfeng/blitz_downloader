<?xml version="1.0" encoding="utf-8"?>
<!--
    「发送到电脑」局域网导出对话框内容。
    用自定义 View 而非 AlertDialog.setMessage，是因为 tvLanStatus 需要在服务运行期间
    随传输完成事件实时刷新（setMessage 在 show() 之后改不动）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tvLanHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary" />

    <TextView
        android:id="@+id/tvLanSplit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:visibility="gone"
        android:textColor="?android:attr/textColorSecondary" />

    <TextView
        android:id="@+id/tvLanUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textIsSelectable="true"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/tvLanStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/tvLanNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/manage_export_lan_status_note"
        android:textSize="11sp"
        android:textColor="?android:attr/textColorSecondary" />

</LinearLayout>
