<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 封面区域 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:scaleType="centerCrop"
                android:background="@drawable/ic_video_placeholder"
                android:contentDescription="@string/app_name" />

            <!-- 文件失效蒙层 -->
            <View
                android:id="@+id/viewInvalidOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#BB000000"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvInvalidBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="#CC000000"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/manage_invalid_label"
                android:textColor="#FFCCCC"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 点赞数徽标：左下，心形图标 + 数字；心形白色，我点赞过（userRelation 含 like）的着抖音红；diggCount<=0 时 GONE -->
            <TextView
                android:id="@+id/tvDiggCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:background="#99000000"
                android:drawableStart="@drawable/ic_heart_solid"
                android:drawablePadding="3dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:visibility="gone"
                tools:ignore="SmallSp" />

            <!--
                「已导出」标记（左上角）：exportCount > 0 且处于多选态时显示。
                只在多选态出现，因为它服务于"这批要不要再导一次"的判断。
            -->
            <TextView
                android:id="@+id/tvExportedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:background="#CC00875A"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/manage_exported_label"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:ignore="SmallSp" />

            <!-- 多选时的选中蒙层 -->
            <View
                android:id="@+id/viewSelectedOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#552196F3"
                android:visibility="gone" />

            <!-- 多选时的复选框（右上角） -->
            <CheckBox
                android:id="@+id/cbManageSelect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:buttonTint="#2196F3"
                android:clickable="false"
                android:focusable="false"
                android:visibility="gone" />

        </FrameLayout>

        <!-- 信息区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="7dp"
            android:paddingTop="6dp"
            android:paddingBottom="7dp">

            <!-- 作者名 -->
            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <!-- 描述文案（空时隐藏） -->
            <TextView
                android:id="@+id/tvDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="10sp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone" />

            <!-- 标签行：downloadType chip + userRelation chips -->
            <LinearLayout
                android:id="@+id/tagContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal" />

            <!--
                用户自定义标签行（无标签时隐藏）。
                vertical 容器：由 ManageGridAdapter 在运行时把 chip 分到最多两行；
                第二行放不下时尾部用「+N」概要 chip。
            -->
            <LinearLayout
                android:id="@+id/userTagContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
