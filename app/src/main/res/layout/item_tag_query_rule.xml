<?xml version="1.0" encoding="utf-8"?>
<!--
    「标签精细检索」的一行规则：[运算符] [标签]  [＋/－]

    基准标签不在这里——它对所有行是同一个值，放在对话框顶部（见 dialog_tag_query.xml）。

    两个下拉走 Material 的 exposed dropdown menu（TextInputLayout + MaterialAutoCompleteTextView），
    不用平台 Spinner。除了对齐 Material Design 规范，它还天然绕开了平台 Spinner 的一个坑：
    Spinner 会在带 layout_weight 的 LinearLayout 第一趟测量（宽度还是 0）时就把子 View 的
    文本 Layout 建好并缓存，第二趟拿到真实宽度后不再重建，导致行宽恒为 0、文字一个都画不出来。
    exposed dropdown 的收起态就是 AutoCompleteTextView 自己，不存在这层缓存。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilTagQueryOp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
        android:theme="@style/ThemeOverlay.BlitzDownloader.TextField"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:hint="@string/manage_tag_query_op_hint">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/actTagQueryOp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:inputType="none"
            android:maxLines="1"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilTagQueryTag"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
        android:theme="@style/ThemeOverlay.BlitzDownloader.TextField"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="@string/manage_tag_query_tag_label">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/actTagQueryTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:inputType="none"
            android:maxLines="1"
            android:textSize="15sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTagQueryRowAction"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="44dp"
        android:layout_height="48dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="0dp"
        android:text="@string/manage_tag_query_add"
        android:textSize="20sp"
        app:cornerRadius="4dp" />

</LinearLayout>
