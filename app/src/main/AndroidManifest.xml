<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />
    <!-- API ≤ 32：旧权限模型，读图片/视频都用 READ_EXTERNAL_STORAGE -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!--
        API 33+（Android 13+）：分离的媒体读权限。
        封面图（.webp/.jpg）需要 READ_MEDIA_IMAGES；
        视频缩略图/播放需要 READ_MEDIA_VIDEO。
        签名变更后，原本由本 App 写入的 MediaStore 文件 owner 校验失败，
        也必须依赖这两个权限才能访问，缺一个对应类型的封面就加载失败。
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 14+：用户在系统选择器里只授予部分媒体时需要此权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!--
        Android 11+：所有文件访问权限。
        只服务于「对系统相册隐藏下载目录」（设置页开关）：目录一旦有 .nomedia，里面的文件在
        MediaStore 里就不再算媒体，READ_MEDIA_* 不再覆盖它们，本 App 用直接文件路径读会失败。
        有了这个权限才能既对相册隐身、又保证自己读得到。详见 util/MediaVisibilityManager。
        它需要用户在系统设置里手动授予，不能用普通权限弹窗；未授予时隐藏功能不可用（而非静默锁死）。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 前台下载服务：批量下载迁到后台执行，退到后台也不中断 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".BlitzApp"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlitzDownloader">
        <activity
            android:name=".activity.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.DouyinWebBrowserActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:label="@string/douyin_browser_title" />
        <!--
            管理页与设置页不再是独立 Activity：它们是 MainActivity 底部导航下的两个 Fragment。
            下面三个页面由管理页启动，返回时 finish() 即落回外壳（tab 仍停在「管理」），
            parentActivityName 只在无栈场景下兜底。
        -->
        <activity
            android:name=".activity.TagManageActivity"
            android:exported="false"
            android:label="@string/manage_menu_tags"
            android:parentActivityName=".activity.MainActivity" />
        <activity
            android:name=".activity.VideoPlayerActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:label="@string/video_player_title"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:parentActivityName=".activity.MainActivity" />
        <activity
            android:name=".activity.ImageViewerActivity"
            android:exported="false"
            android:label="@string/image_viewer_title"
            android:parentActivityName=".activity.MainActivity" />

        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>